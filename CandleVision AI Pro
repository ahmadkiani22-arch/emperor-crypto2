def analyze_market(req: AnalyzeRequest):
    candles = get_klines(req.symbol, req.interval, req.limit)
    result = analyze(candles)
    result["symbol"] = req.symbol.upper()
    result["interval"] = req.interval
    result["candles"] = candles
    return result

